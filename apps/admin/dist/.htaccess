# Static SPA rewrite for react-router's BrowserRouter (src/main.tsx). Any request that isn't
# a real file on disk falls through to index.html so client-side routing can take over —
# the Apache/LiteSpeed equivalent of apps/admin/vercel.json's rewrite rule, which this
# replaces now that admin is deployed as static files rather than to Vercel.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
